# Only XKIRO_API_KEY is required. The base URL, model, and provider order
# below are already the code defaults, shown here for reference.
# Provider order: the first successful provider wins.
RESUME_AI_PROVIDERS=xkiro,opencode

# Keyless OpenCode Zen free provider (fallback).
OPENCODE_BASE_URL=https://opencode.ai/zen/v1
OPENCODE_MODEL=hy3-free

# xKiro primary. Keep the key secret and server-side only.
XKIRO_BASE_URL=https://api.xkiro.com/v1
XKIRO_MODEL=openai/gpt-5.6-luna
XKIRO_API_KEY=

# Optional OpenAI adapter. Use RESUME_AI_PROVIDERS=openai to select it.
OPENAI_MODEL=
OPENAI_API_KEY=
