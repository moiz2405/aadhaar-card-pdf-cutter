# Provider order. The first successful provider wins.
RESUME_AI_PROVIDERS=opencode,xkiro

# Keyless OpenCode Zen free provider.
OPENCODE_BASE_URL=https://opencode.ai/zen/v1
OPENCODE_MODEL=hy3-free

# Optional xKiro fallback. Keep this secret and server-side only.
XKIRO_BASE_URL=https://api.xkiro.com/v1
XKIRO_MODEL=openai/gpt-5.6-luna
XKIRO_API_KEY=

# Optional OpenAI adapter. Use RESUME_AI_PROVIDERS=openai to select it.
OPENAI_MODEL=
OPENAI_API_KEY=
